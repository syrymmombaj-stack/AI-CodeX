OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4.1-mini
PORT=3000
# Optional extra frontend origins, comma-separated. Same-origin works by default.
FRONTEND_ORIGIN=
# Optional workspace password; never put the OpenAI key in the browser.
APP_ACCESS_TOKEN=
# Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
